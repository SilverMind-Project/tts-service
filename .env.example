# TTS Service
# GPU device: cuda, cuda:0, cuda:1, cpu
CUDA_DEVICE=cuda

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Hugging Face cache (optional — set to pre-downloaded models dir)
# HF_HOME=/app/models

# Server
HOST=0.0.0.0
PORT=8200

# Wyoming OpenAI proxy (Home Assistant voice integration)
# Uncomment to enable the wyoming_openai sidecar service
# WYOMING_TTS_OPENAI_URL=http://tts:8200/v1
# WYOMING_TTS_MODELS=svara,parler,fish_speech,seamless,melo,edge_tts
# WYOMING_TTS_VOICES=speaker_0,speaker_1,female_calm,male_clear,default
